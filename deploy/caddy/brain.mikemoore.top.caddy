# Production site-only snippet для Caddy.
# Не устанавливайте этот файл вместо глобального /etc/caddy/Caddyfile.
# Подключите его только через уже существующий owner-managed import либо через
# explicit first-install bootstrap с import site-directory.

brain.mikemoore.top {
    # Operational access logs идут в Caddy service journal, но GitHub OAuth
    # endpoints с потенциальными code/state в query не логируются.
    log {
        output stderr
        format json
    }
    log_skip /auth/github*

    # Caddy сохраняет входящий Host и передаёт стандартные
    # X-Forwarded-Host/X-Forwarded-Proto к loopback upstream.
    reverse_proxy 127.0.0.1:8123
}
