# Байткод Python и окружения
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Артефакты сборки
build/
dist/
*.egg-info/

# Кэши тестов, coverage, lint и type-check
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# Runtime-состояние и производные данные
.local/
*.db
*.sqlite
*.sqlite3
*.log
*.pid

# Локальная конфигурация и секреты
.env
.env.*
!.env.example
*.pem
*.key

# Редакторы и операционные системы
.idea/
.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
