# Байткод Python и окружения
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Артефакты сборки
build/
dist/
node_modules/
*.egg-info/

# Кэши тестов, coverage, lint и type-check
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# Runtime-состояние и производные данные
.local/
runtime/
data/vault/
*.db
*.sqlite
*.sqlite3
*.db-*
*.sqlite-*
*.sqlite3-*
*.db-journal
*.sqlite-journal
*.sqlite3-journal
*.log
*.pid

# Локальная конфигурация и секреты
.env
.env.*
*.env
!.env.example
*.pem
*.key

# Тестовые и browser/QA-артефакты
.pytest-tmp*/
.tmp_pytest*/
test-results/
playwright-report/
blob-report/
*.trace.zip
*.har
storage-state*.json
auth-state*.json

# Редакторы и операционные системы
.idea/
.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp

# Project-local Impeccable runtime state (shared config.json remains reviewable)
.impeccable/config.local.json
.impeccable/config.local.json.*
.impeccable/live/
.impeccable/.cache/
.impeccable/*.log
.impeccable/*.ndjson
.impeccable/*.pid
# Локальные производные данные Graphify
graphify-out/
