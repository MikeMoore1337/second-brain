# Выберите этот файл явно: uv run second-brain --env-file .env doctor
SECOND_BRAIN_VAULT_PATH=../second-brain-vault

# Loopback development keeps the existing local workflow. Set to github only
# in the explicitly configured public deployment environment.
SECOND_BRAIN_WEB_AUTH=disabled
SECOND_BRAIN_PUBLIC_BASE_URL=http://127.0.0.1:8123
SECOND_BRAIN_GITHUB_CLIENT_ID=
SECOND_BRAIN_GITHUB_CLIENT_SECRET=
SECOND_BRAIN_GITHUB_ALLOWED_USER_ID=42142321
SECOND_BRAIN_SESSION_SECRET=
SECOND_BRAIN_SESSION_TTL_SECONDS=43200
SECOND_BRAIN_OAUTH_STATE_TTL_SECONDS=600

# Опциональные runtime settings для явного CloudflareWorkersAiLlmPort или
# CloudflareWorkersAiAdvisorPort вызова; новые secrets не добавляются.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
